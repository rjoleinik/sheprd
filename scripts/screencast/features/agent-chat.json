{
  "id": "agent-chat",
  "feature": "ACP chats",
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+n"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "cd ~/code/forecast && clear"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ]
  ],
  "segments": [
    {
      "actions": []
    },
    {
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "click",
          880,
          94
        ],
        [
          "wait",
          2.4
        ],
        [
          "type",
          "Add a --json flag to the forecast command"
        ],
        [
          "wait",
          0.6
        ],
        [
          "key",
          "return"
        ]
      ]
    },
    {
      "actions": []
    },
    {
      "actions": []
    },
    {
      "actions": []
    }
  ],
  "teardown": [
    [
      "key",
      "escape"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+p"
    ],
    [
      "wait",
      0.8
    ],
    [
      "type",
      "close workspace"
    ],
    [
      "wait",
      0.8
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ],
    [
      "type",
      "close"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.5
    ]
  ]
}

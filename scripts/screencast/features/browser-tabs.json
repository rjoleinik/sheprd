{
  "id": "browser-tabs",
  "feature": "Browser tabs",
  "windows": [
    "classic"
  ],
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+n"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "cd ~/code/forecast && clear"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ]
  ],
  "segments": [
    {
      "actions": []
    },
    {
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "key",
          "cmd+shift+b"
        ],
        [
          "wait",
          1.2
        ],
        [
          "click",
          1530,
          162
        ],
        [
          "slowtype",
          "sheprd.org",
          0.03
        ],
        [
          "key",
          "return"
        ]
      ],
      "shortcut": "ctrl-alt-shift-b"
    },
    {
      "actions": [
        [
          "wait",
          2.5
        ],
        [
          "key",
          "down"
        ],
        [
          "key",
          "down"
        ],
        [
          "key",
          "down"
        ]
      ]
    },
    {
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "click",
          2426,
          162
        ]
      ]
    },
    {
      "actions": []
    }
  ],
  "teardown": [
    [
      "key",
      "escape"
    ],
    [
      "key",
      "cmd+shift+w"
    ],
    [
      "wait",
      0.8
    ],
    [
      "key",
      "escape"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+p"
    ],
    [
      "wait",
      0.8
    ],
    [
      "type",
      "close workspace"
    ],
    [
      "wait",
      0.8
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ],
    [
      "type",
      "close"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.5
    ]
  ]
}

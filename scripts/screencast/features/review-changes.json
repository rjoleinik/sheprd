{
  "id": "review-changes",
  "feature": "Review Changes",
  "title": {
    "en": "Review Changes",
    "fr": "Relire les changements"
  },
  "setup": [
    [
      "exec",
      "cd ~/code/forecast && git reset -q --hard && git clean -qfd; sed -i '' 's/^theme = .*/theme = \"Default\"/' ~/.config/herdr/config-gpui.local.toml; sleep 1"
    ],
    [
      "exec",
      "printf '%s\\n' '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"session/prompt\",\"params\":{\"sessionId\":\"s1\"}}' | ~/stub/gemini >/dev/null"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+n"
    ],
    [
      "wait",
      1.5
    ],
    [
      "type",
      "cd ~/code/forecast && clear"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ]
  ],
  "segments": [
    {
      "say": {
        "en": "Before you ship what an agent wrote, review it in Sheprd.",
        "fr": "Avant de livrer ce qu'un agent a écrit, relisez-le dans Sheprd."
      },
      "actions": []
    },
    {
      "say": {
        "en": "Open Review Changes from the palette: every file the work touched.",
        "fr": "Ouvrez « Relire les changements » depuis la palette : chaque fichier modifié."
      },
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "key",
          "cmd+shift+p"
        ],
        [
          "wait",
          0.8
        ],
        [
          "slowtype",
          "review",
          0.03
        ],
        [
          "wait",
          0.6
        ],
        [
          "key",
          "return"
        ]
      ]
    },
    {
      "say": {
        "en": "Each change sits beside the code it replaces.",
        "fr": "Chaque modification s'affiche face au code qu'elle remplace."
      },
      "actions": []
    },
    {
      "say": {
        "en": "Click a line number to leave a note for the agent.",
        "fr": "Cliquez sur un numéro de ligne pour laisser une note à l'agent."
      },
      "actions": [
        [
          "wait",
          0.3
        ],
        [
          "click",
          {
            "classic": [
              1219,
              545
            ],
            "moonframe": [
              1229,
              538
            ]
          }
        ],
        [
          "wait",
          0.8
        ],
        [
          "type",
          "Print an error for unknown cities"
        ],
        [
          "wait",
          0.4
        ],
        [
          "click",
          {
            "classic": [
              2043,
              358
            ],
            "moonframe": [
              2035,
              337
            ]
          }
        ]
      ]
    },
    {
      "say": {
        "en": "Then mark the file viewed, and move on to the next.",
        "fr": "Puis marquez le fichier comme vu, et passez au suivant."
      },
      "actions": [
        [
          "wait",
          0.4
        ],
        [
          "click",
          {
            "classic": [
              1815,
              225
            ],
            "moonframe": [
              1820,
              218
            ]
          }
        ]
      ]
    }
  ],
  "teardown": [
    [
      "wait",
      0.5
    ],
    [
      "click",
      {
        "classic": [
          1815,
          225
        ],
        "moonframe": [
          1820,
          218
        ]
      }
    ],
    [
      "wait",
      0.5
    ],
    [
      "key",
      "escape"
    ],
    [
      "key",
      "escape"
    ],
    [
      "click",
      1600,
      1000
    ],
    [
      "key",
      "cmd+shift+p"
    ],
    [
      "wait",
      0.8
    ],
    [
      "type",
      "close workspace"
    ],
    [
      "wait",
      0.8
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.2
    ],
    [
      "type",
      "close"
    ],
    [
      "key",
      "return"
    ],
    [
      "wait",
      1.5
    ]
  ]
}
